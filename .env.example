# PMFlow 環境變數 — 複製成 .env 後編輯
#   cp .env.example .env
#
# 只有正式部署（docker-compose.yml）需要這個檔。
# 本機開發（docker-compose.dev.yml）已經內建預設值，不用設定任何東西。
#
# ⚠️ 用 Synology Container Manager 的「專案」介面部署的話，這個檔案沒有用 ——
#    它的介面建不出 .env 這種點開頭的隱藏檔，${變數} 會全部讀不到而啟動失敗。
#    那種情況請改用 docker-compose.synology.yml（所有值直接寫死）。

# ══════════ 必填 ══════════
POSTGRES_PASSWORD=CHANGE_ME_請換成一長串隨機字串

# 用這行產生：openssl rand -base64 48
# Windows 沒有 openssl 的話：powershell -c "[Convert]::ToBase64String((1..48|%{Get-Random -Max 256}))"
JWT_SECRET=CHANGE_ME_openssl_rand_base64_48

# ══════════ 映像來源 ══════════
# 從哪個 registry 拉映像。二選一：
#   ghcr.io    → IMAGE_OWNER 填 GitHub 帳號（公開 repo 免登入、無拉取次數限制，推薦）
#   docker.io  → IMAGE_OWNER 填 Docker Hub 帳號
REGISTRY=ghcr.io
IMAGE_OWNER=your-github-name       # 換成你的 GitHub（或 Docker Hub）帳號
# ⚠️ 版本號沒有開頭的 v。git tag 打 v1.0.0，映像標籤是 1.0.0 ——
#    docker/metadata-action 的 semver 樣板會去掉 v。寫 v1.0.0 會 manifest unknown。
PMFLOW_VERSION=latest              # 正式環境建議鎖版本，例如 1.0.0

# ══════════ 對外連線 ══════════
HTTP_PORT=8480                     # Synology DSM 佔用 80/443，所以用 8480

# ══════════ NAS 環境 ══════════
TZ=Asia/Taipei
# 不需要 PUID / PGID：映像以 uid 10001 執行，資料全在具名 volume，
# 沒有 bind mount 要對齊 NAS 帳號。

# ══════════ 資源限制 ══════════
# 8GB 以上的機器用預設就好
API_MEM_LIMIT=512m
PG_MEM_LIMIT=1g
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE=768MB
# 2GB 小機器改成：API_MEM_LIMIT=384m PG_MEM_LIMIT=512m PG_SHARED_BUFFERS=128MB

# ══════════ 資料庫 ══════════
POSTGRES_DB=pmflow
POSTGRES_USER=pmflow

# ══════════ 帳號政策 ══════════
ALLOW_SELF_REGISTRATION=true
ALLOWED_EMAIL_DOMAINS=             # 限制可註冊的信箱網域，逗號分隔。留空 = 不限制
ACCESS_TTL_SEC=900                 # access token 15 分鐘
REFRESH_TTL_SEC=604800             # refresh token 7 天
SEED_DEMO=false                    # 正式環境不要建示範資料

# ══════════ 用 Google / Apple 的帳號登入 ══════════
# 整段留空就是「不啟用」——登入頁不會畫那兩顆按鈕，其他功能完全不受影響。
# 這是綁定不是取代：email + 密碼那條路一直都在。
# 申請步驟見 README 的「用 Google／Apple 的帳號登入」。
#
# ⚠️ 兩個外部條件，改不了：
#    1. 兩家的 callback 網址都必須**對外可達**。Apple 連 localhost 都不收，
#       所以在本機 http://localhost:8480 上只驗得到「按鈕有沒有正確導出去」。
#    2. Apple 需要**付費**的 Apple Developer Program 帳號（一年 US$99）才產得出 .p8 金鑰。
#       Google 不用付費。

# 這個站從外面看的網址（含 http:// 或 https://，結尾不要斜線）。
# callback 網址是拿它拼出來的，沒填就等於整組不啟用。
PUBLIC_URL=                        # 例如 https://pm.example.com

# ── Google（Google Cloud Console → API 和服務 → 憑證 → OAuth 用戶端 ID → 網路應用程式）──
# 「已授權的重新導向 URI」要填：<PUBLIC_URL>/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Apple（Apple Developer → Certificates, Identifiers & Profiles）──
# APPLE_CLIENT_ID 填的是 **Services ID**（例如 com.example.pmflow.web），不是 App ID。
# 那個 Services ID 的 Return URL 要填：<PUBLIC_URL>/api/v1/auth/oauth/apple/callback
# APPLE_PRIVATE_KEY 是下載的 .p8 內容，換行請寫成 \n（.env 讀不了真正的換行）；
# 也接受把整份 .p8 再 base64 一次之後貼進來。
# ⚠️ .p8 只能下載一次，而且**絕對不要 commit 進 repo**。
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ══════════ 發文追蹤 ══════════
INQUIRY_DEFAULT_DUE_DAYS=7         # 沒填期望回覆日時，自動帶「提問日 + N 個工作天」。0 = 不預設

# ══════════ 備份 ══════════
BACKUP_AT_HOUR=3
BACKUP_KEEP_DAYS=30
