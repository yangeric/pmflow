# PMFlow 環境變數 — 複製成 .env 後編輯
#   cp .env.example .env
#
# 只有正式部署（docker-compose.yml）需要這個檔。
# 本機開發（docker-compose.dev.yml）已經內建預設值，不用設定任何東西。

# ══════════ 必填 ══════════
POSTGRES_PASSWORD=CHANGE_ME_請換成一長串隨機字串

# 用這行產生：openssl rand -base64 48
# Windows 沒有 openssl 的話：powershell -c "[Convert]::ToBase64String((1..48|%{Get-Random -Max 256}))"
JWT_SECRET=CHANGE_ME_openssl_rand_base64_48

# ══════════ 映像來源 ══════════
# 從哪個 registry 拉映像。二選一：
#   ghcr.io    → IMAGE_OWNER 填 GitHub 帳號（公開 repo 免登入、無拉取次數限制，推薦）
#   docker.io  → IMAGE_OWNER 填 Docker Hub 帳號
# 從哪個 registry 拉映像。二選一：
#   ghcr.io    → IMAGE_OWNER 填 GitHub 帳號（公開 repo 免登入、無拉取次數限制，推薦）
#   docker.io  → IMAGE_OWNER 填 Docker Hub 帳號
REGISTRY=ghcr.io
IMAGE_OWNER=your-github-name       # 換成你的 GitHub（或 Docker Hub）帳號
PMFLOW_VERSION=latest              # 正式環境建議鎖版本，例如 v1.0.0

# ══════════ 對外連線 ══════════
HTTP_PORT=8480                     # Synology DSM 佔用 80/443，所以用 8480

# ══════════ NAS 環境 ══════════
TZ=Asia/Taipei
PUID=1026                          # 用 `id 你的帳號` 查。Synology 常是 1026，QNAP 常是 1000
PGID=100

# ══════════ 資源限制 ══════════
# 8GB 以上的機器用預設就好
API_MEM_LIMIT=512m
PG_MEM_LIMIT=1g
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE=768MB
# 2GB 小機器改成：API_MEM_LIMIT=384m PG_MEM_LIMIT=512m PG_SHARED_BUFFERS=128MB

# ══════════ 資料庫 ══════════
POSTGRES_DB=pmflow
POSTGRES_USER=pmflow

# ══════════ 帳號政策 ══════════
ALLOW_SELF_REGISTRATION=true
ALLOWED_EMAIL_DOMAINS=             # 限制可註冊的信箱網域，逗號分隔。留空 = 不限制
ACCESS_TTL_SEC=900                 # access token 15 分鐘
REFRESH_TTL_SEC=604800             # refresh token 7 天
SEED_DEMO=false                    # 正式環境不要建示範資料

# ══════════ 發文追蹤 ══════════
INQUIRY_DEFAULT_DUE_DAYS=7         # 沒填期望回覆日時，自動帶「提問日 + N 個工作天」。0 = 不預設

# ══════════ 備份 ══════════
BACKUP_AT_HOUR=3
BACKUP_KEEP_DAYS=30
